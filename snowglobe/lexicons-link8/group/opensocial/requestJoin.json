{
	"lexicon": 1,
	"id": "group.opensocial.requestJoin",
	"defs": {
		"main": {
			"type": "procedure",
			"description": "Ask to join a group, optionally redeeming an invitation. Uses service auth from the caller. Admitted members get the default roles.",
			"input": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["group"],
					"properties": {
						"group": {
							"type": "string",
							"format": "did",
							"description": "The group DID."
						},
						"invite": {
							"type": "string",
							"format": "at-uri",
							"description": "An invitation from this group to the caller."
						},
						"message": {
							"type": "string",
							"maxGraphemes": 2000,
							"maxLength": 20000
						}
					}
				}
			},
			"output": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["status"],
					"properties": {
						"status": {
							"type": "string",
							"knownValues": ["pending", "admitted"]
						},
						"request": {
							"type": "ref",
							"ref": "group.opensocial.defs#joinRequest",
							"description": "Present when pending."
						},
						"membership": {
							"type": "ref",
							"ref": "com.atproto.repo.strongRef#main",
							"description": "Present when admitted."
						}
					}
				}
			},
			"errors": [
				{
					"name": "GroupNotFound",
					"description": "The group isn't hosted here."
				},
				{
					"name": "InvalidInvite",
					"description": "The invitation is expired, revoked, or not addressed to the caller."
				},
				{
					"name": "JoinClosed",
					"description": "The group requires an invitation."
				}
			]
		}
	}
}
