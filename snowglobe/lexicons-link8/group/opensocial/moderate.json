{
	"lexicon": 1,
	"id": "group.opensocial.moderate",
	"defs": {
		"main": {
			"type": "permission-set",
			"description": "For group-DID sessions.",
			"title": "Group moderation",
			"detail": "Review reports and moderation history, and label members.",
			"permissions": [
				{
					"type": "permission",
					"resource": "space",
					"spaceType": "group.opensocial.meta",
					"authority": "self",
					"skey": "self",
					"collection": ["com.atproto.label.label"],
					"action": ["read", "create", "update", "delete"]
				},
				{
					"type": "permission",
					"resource": "space",
					"spaceType": "group.opensocial.members",
					"authority": "self",
					"skey": "self",
					"collection": ["com.atproto.label.label"],
					"action": ["read", "create", "update", "delete"]
				},
				{
					"type": "permission",
					"resource": "rpc",
					"aud": "*",
					"lxm": [
						"group.opensocial.listSubjects",
						"group.opensocial.getSubjectHistory",
						"group.opensocial.resolveSubject"
					]
				}
			]
		}
	}
}
