{
	"lexicon": 1,
	"id": "group.opensocial.createReport",
	"defs": {
		"main": {
			"type": "procedure",
			"description": "Report an account or record in a group, opening or reopening it in the moderation queue. Uses service auth from the caller, who must be able to read the subject's space.",
			"input": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["group", "subject", "reasonType"],
					"properties": {
						"group": {
							"type": "string",
							"format": "did",
							"description": "The group DID."
						},
						"subject": {
							"type": "union",
							"refs": [
								"group.opensocial.defs#accountSubject",
								"group.opensocial.defs#recordSubject"
							]
						},
						"reasonType": {
							"type": "ref",
							"ref": "com.atproto.moderation.defs#reasonType"
						},
						"reason": {
							"type": "string",
							"maxGraphemes": 2000,
							"maxLength": 20000
						},
						"rule": {
							"type": "string",
							"format": "at-uri",
							"description": "A rule in the group's meta space."
						}
					}
				}
			},
			"output": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["id", "createdAt"],
					"properties": {
						"id": {
							"type": "string",
							"minLength": 1,
							"maxLength": 512
						},
						"createdAt": {
							"type": "string",
							"format": "datetime"
						}
					}
				}
			},
			"errors": [
				{
					"name": "GroupNotFound",
					"description": "The group isn't hosted here."
				},
				{
					"name": "InvalidSubject",
					"description": "The subject isn't an account or record in this group."
				}
			]
		}
	}
}
