{
	"lexicon": 1,
	"id": "group.opensocial.declaration",
	"defs": {
		"main": {
			"type": "record",
			"description": "Marks this DID as a group, in its public repo. Publish only when meta is public.",
			"key": "literal:self",
			"record": {
				"type": "object",
				"required": ["meta"],
				"properties": {
					"meta": {
						"type": "string",
						"format": "space-ref",
						"description": "The group's meta space."
					}
				}
			}
		}
	}
}
