{
	"lexicon": 1,
	"id": "group.opensocial.getSubjectHistory",
	"defs": {
		"main": {
			"type": "query",
			"description": "Get a subject's moderation history, oldest first.",
			"parameters": {
				"type": "params",
				"required": ["subject"],
				"properties": {
					"subject": {
						"type": "string",
						"format": "uri",
						"description": "An account DID or record URI."
					},
					"cid": {
						"type": "string",
						"format": "cid",
						"description": "Narrow a record subject to one version."
					},
					"limit": {
						"type": "integer",
						"minimum": 1,
						"maximum": 100,
						"default": 50
					},
					"cursor": {
						"type": "string"
					}
				}
			},
			"output": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["events"],
					"properties": {
						"cursor": {
							"type": "string"
						},
						"events": {
							"type": "array",
							"items": {
								"type": "ref",
								"ref": "group.opensocial.defs#moderationEvent"
							}
						}
					}
				}
			},
			"errors": [
				{
					"name": "InvalidSubject",
					"description": "The subject isn't an account or record in this group."
				}
			]
		}
	}
}
