{
	"lexicon": 1,
	"id": "group.opensocial.listJoinRequests",
	"defs": {
		"main": {
			"type": "query",
			"description": "List pending join requests. Approve one by writing the requester's membership.",
			"parameters": {
				"type": "params",
				"properties": {
					"limit": {
						"type": "integer",
						"minimum": 1,
						"maximum": 100,
						"default": 50
					},
					"cursor": {
						"type": "string"
					}
				}
			},
			"output": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["requests"],
					"properties": {
						"cursor": {
							"type": "string"
						},
						"requests": {
							"type": "array",
							"items": {
								"type": "ref",
								"ref": "group.opensocial.defs#joinRequest"
							}
						}
					}
				}
			}
		}
	}
}
