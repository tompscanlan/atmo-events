diff --git a/dist/ws.cjs b/dist/ws.cjs
index 20c2d56e10cb656bce262baf9214a46dc3db32f1..1fd91d0be5cd1de0d9818380d74a230394cc5fba 100644
--- a/dist/ws.cjs
+++ b/dist/ws.cjs
@@ -41,11 +41,24 @@ const Events = {
 function assert(condition, msg) {
   if (!condition) throw new Error(msg);
 }
+// A message event is copied field by field, not by passing the event itself as
+// the init dict: that hands the constructor `source: null`, which workerd
+// 2026-09-21 rejects ("Incorrect type for the 'source' field on 'Initializer'"),
+// killing every WebSocket after its first message. A WebSocket message has no
+// source or ports to carry, so nothing is lost.
+function cloneMessageEvent(e) {
+  return new MessageEvent(e.type, {
+    data: e.data,
+    origin: e.origin,
+    lastEventId: e.lastEventId
+  });
+}
 function cloneEventBrowser(e) {
+  if ("data" in e) return cloneMessageEvent(e);
   return new e.constructor(e.type, e);
 }
 function cloneEventNode(e) {
-  if ("data" in e) return new MessageEvent(e.type, e);
+  if ("data" in e) return cloneMessageEvent(e);
   if ("code" in e || "reason" in e)
     return new CloseEvent(e.code || 1999, e.reason || "unknown reason", e);
   if ("error" in e) return new ErrorEvent(e.error, e);
