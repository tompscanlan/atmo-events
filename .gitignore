!.env.test

# Wrangler local secrets. The `.env*` rules above do NOT cover these:
# `.dev.vars` is the file `wrangler dev` reads for Worker secrets, and it was
# untracked-but-committable only because nobody had written one yet.
# GROUP_CREDENTIALS (group PDS passwords) and the alpha invite code both
# belong in it locally.
.dev.vars
.dev.vars.*
!.dev.vars.example

# VOD processing data (audio, transcripts)
scripts/vod-processing/data
scripts/vod-processing/model

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Tunnel-generated (only meaningful while tunnel is running)
**/static/.well-known/did.json
