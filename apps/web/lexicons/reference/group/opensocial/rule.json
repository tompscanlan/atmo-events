{
  "lexicon": 1,
  "id": "group.opensocial.rule",
  "defs": {
    "main": {
      "type": "record",
      "description": "A rule or guideline, authored by the group DID in meta/self. Updates preserve the rkey so its URI remains stable for moderation citations.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["title", "text"],
        "properties": {
          "title": {
            "type": "string",
            "maxGraphemes": 64,
            "maxLength": 640
          },
          "text": {
            "type": "string",
            "maxGraphemes": 2000,
            "maxLength": 20000
          },
          "order": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
