{
  "lexicon": 1,
  "id": "group.opensocial.participate",
  "defs": {
    "main": {
      "type": "permission-set",
      "description": "For personal sessions.",
      "title": "Groups",
      "detail": "See groups and your invites, join or leave groups, and report content.",
      "permissions": [
        {
          "type": "permission",
          "resource": "space",
          "spaceType": "group.opensocial.meta",
          "authority": "*",
          "skey": "self",
          "action": ["read"]
        },
        {
          "type": "permission",
          "resource": "space",
          "spaceType": "group.opensocial.members",
          "authority": "*",
          "skey": "self",
          "collection": ["group.opensocial.acceptance"],
          "action": ["read", "create", "update", "delete"]
        },
        {
          "type": "permission",
          "resource": "space",
          "spaceType": "group.opensocial.invites",
          "authority": "self",
          "skey": "self",
          "action": ["read"],
          "manage": ["create"]
        },
        {
          "type": "permission",
          "resource": "rpc",
          "aud": "*",
          "lxm": [
            "group.opensocial.requestJoin",
            "group.opensocial.cancelJoinRequest",
            "group.opensocial.leaveGroup",
            "group.opensocial.createReport"
          ]
        }
      ]
    }
  }
}
