{
  "lexicon": 1,
  "id": "group.opensocial.role",
  "defs": {
    "main": {
      "type": "record",
      "description": "A group role, in members. The rkey is the role ID.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["displayName"],
        "properties": {
          "displayName": {
            "type": "string",
            "maxGraphemes": 64,
            "maxLength": 640
          },
          "description": {
            "type": "string",
            "maxGraphemes": 2000,
            "maxLength": 20000
          },
          "default": {
            "type": "boolean",
            "default": false,
            "description": "Granted to members who join through requestJoin."
          }
        }
      }
    }
  }
}
