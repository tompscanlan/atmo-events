{
  "lexicon": 1,
  "id": "group.opensocial.role",
  "defs": {
    "main": {
      "type": "record",
      "description": "Role declaration authored by the group DID in members/self. The rkey is the role ID and must be a valid record key. Actions are bound separately in permissions/self.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["displayName"],
        "properties": {
          "displayName": {
            "type": "string",
            "maxGraphemes": 64,
            "maxLength": 640
          },
          "description": {
            "type": "string",
            "maxGraphemes": 2000,
            "maxLength": 20000
          }
        }
      }
    }
  }
}
