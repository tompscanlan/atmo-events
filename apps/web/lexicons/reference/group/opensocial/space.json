        "required": ["space", "createdAt"],
        "properties": {
          "space": {
            "type": "string",
            "format": "space-ref",
            "description": "A space under this group."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
