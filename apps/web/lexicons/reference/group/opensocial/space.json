{
  "lexicon": 1,
  "id": "group.opensocial.space",
  "defs": {
    "main": {
      "type": "record",
      "description": "Index entry authored by the group DID in members/self. Exactly one entry per space URI, including meta/self and members/self. Modality data lives in the indexed space, not here.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["space", "createdAt"],
        "properties": {
          "space": {
            "type": "string",
            "description": "Space URI whose authority must be this group DID.",
            "format": "space-ref"
          },
          "displayName": {
            "type": "string",
            "maxGraphemes": 64,
            "maxLength": 640
          },
          "description": {
            "type": "string",
            "maxGraphemes": 2000,
            "maxLength": 20000
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
