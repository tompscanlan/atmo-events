{
  "lexicon": 1,
  "id": "group.opensocial.profile",
  "defs": {
    "main": {
      "type": "record",
      "description": "Group profile, authored by the group DID in meta/self.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": ["displayName", "joinPolicy"],
        "properties": {
          "displayName": {
            "type": "string",
            "maxGraphemes": 64,
            "maxLength": 640
          },
          "description": {
            "type": "string",
            "maxGraphemes": 2000,
            "maxLength": 20000
          },
          "avatar": {
            "type": "blob",
            "accept": ["image/png", "image/jpeg", "image/webp"],
            "maxSize": 2000000
          },
          "banner": {
            "type": "blob",
            "accept": ["image/png", "image/jpeg", "image/webp"],
            "maxSize": 2000000
          },
          "joinPolicy": {
            "type": "ref",
            "ref": "group.opensocial.defs#joinPolicy"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Absolute HTTP or HTTPS URL for the group website, if it has one. Hosts must reject other schemes; clients must check the scheme before rendering a link. The uri format alone does not enforce this constraint."
          }
        }
      }
    }
  }
}
