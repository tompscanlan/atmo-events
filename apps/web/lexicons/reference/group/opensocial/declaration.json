{
  "lexicon": 1,
  "id": "group.opensocial.declaration",
  "defs": {
    "main": {
      "type": "record",
      "description": "Optional discovery record in the group public broadcast repo, authored by the group DID. Publish only when meta/self is publicly readable.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": ["meta"],
        "properties": {
          "meta": {
            "type": "string",
            "description": "Must be at://{authorDid}/space/group.opensocial.meta/self.",
            "format": "space-ref"
          }
        }
      }
    }
  }
}
