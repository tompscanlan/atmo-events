# Generate both with: pnpm env:setup-dev
CLIENT_ASSERTION_KEY=
COOKIE_SECRET=

# Set to your tunnel URL to use a confidential client in dev
# OAUTH_PUBLIC_URL=https://your-tunnel.trycloudflare.com

# atproto network (optional). Every address atmo uses on the atproto network,
# each named after its service. Unset, each is the public network's address,
# so the app runs as before. Set them to point atmo at a local test network or
# a sandbox. PUBLIC_ is SvelteKit's prefix for a setting the browser reads too.
# See src/lib/atproto/network.ts.
# PUBLIC_PLC_URL=https://plc.example.com
# PUBLIC_SLINGSHOT_URL=https://slingshot.example.com
# Jetstream and relay take a comma-separated list:
# PUBLIC_JETSTREAM_URLS=wss://jetstream.example.com
# PUBLIC_RELAY_URLS=https://relay.example.com
# PUBLIC_CONSTELLATION_URL=https://constellation.example.com
# Where the sign-up button sends people:
# PUBLIC_SIGNUP_PDS_URL=https://pds.example.com
# Handle DNS lookups, the Bluesky API, actor search and record stats:
# PUBLIC_DOH_URL=https://dns.example.com/dns-query
# PUBLIC_BSKY_APPVIEW_URL=https://appview.example.com
# PUBLIC_TYPEAHEAD_URL=https://typeahead.example.com
# PUBLIC_UFOS_URL=https://ufos.example.com
# Event and profile images. {did}, {cid} and {format} are filled in:
# PUBLIC_IMAGE_URL_TEMPLATE=https://pds.example.com/xrpc/com.atproto.sync.getBlob?did={did}&cid={cid}

# Search (optional). When SEARCH_URL / SEARCH_API_KEY are unset, search falls
# back to the D1 LIKE query and near-me is unavailable, so the app runs fine
# without any of these. See the "search (optional)" section in the README.
# Read path (search + near-me): base url + a read-only Default Search API Key.
# SEARCH_INDEX (defaults to `events`) is the one index var, shared by the read
# path and the write sink below.
# SEARCH_URL=http://localhost:7700
# SEARCH_API_KEY=
# SEARCH_INDEX=events
# Write path (the cron ingest sink). Kept separate from the read url/key so the
# writer uses the admin key while the read path stays on the search-only key.
# The index is SEARCH_INDEX above (the sink writes the same index it reads).
# SEARCH_SINK_URL=http://localhost:7700
# SEARCH_SINK_API_KEY=
# Near-me geocoding (optional; layered on the search sink above). Resolves the
# coordinates of address-only events and writes _geo into the index so they
# appear in near-me. Unset → the in-cron drip runs keyless against public OSM
# Nominatim at a safe trickle. See the "near-me geocoding" section in the README.
# For real volume / a bulk backfill, use LocationIQ (set both URL and KEY):
# GEOCODER_URL=https://us1.locationiq.com/v1/search
# GEOCODER_KEY=
# Identify your deployment to public Nominatim (its usage policy requires it):
# GEOCODER_USER_AGENT=atmo-events (you@example.com)
# Minimum ms between geocoder calls (default 1100; floored to 1000 on public Nominatim):
# GEOCODE_SLEEP_MS=1100

# Groups (optional). Groups live at an opensocial.group group host; without one,
# groups are hidden and the app runs fine. Creating and linking a group also
# need OAUTH_PUBLIC_URL above and the OAUTH_SESSIONS store. See
# src/lib/groups/README.md.
# GROUP_HOST_URL=https://grouphost.example.com
